{
  "description": "Opt-in feedback reminders and auto mode. They stay silent unless enabled with `config reminders on`, `config mode auto`, AGENT_LEARNINGS_REMINDERS=1 or AGENT_LEARNINGS_MODE=auto.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Skill|Agent|Task|mcp__.*",
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/cli.js\" hook claude:PostToolUse", "async": true, "timeout": 10 }]
      }
    ],
    "UserPromptExpansion": [
      {
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/cli.js\" hook claude:UserPromptExpansion", "async": true, "timeout": 10 }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/cli.js\" hook claude:Stop", "timeout": 10 }]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/cli.js\" hook claude:SessionEnd", "timeout": 5 }]
      }
    ]
  }
}
